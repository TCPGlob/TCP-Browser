# TCP Browser configuration.
#
# Every variable is optional: copy this file to `.env` (or `.env.local`) and set
# only the ones you need. `server.ts` loads it through dotenv at startup.

# Port the HTTP server listens on. Default: 3000
PORT=3000

# "production" serves the prebuilt ./dist bundle; "development" attaches the
# Vite dev middleware with hot reload. When unset, TCP Browser auto-detects:
# if ./dist/index.html exists it serves the production build.
NODE_ENV=development

# Set to "true" to disable Vite's hot-reload websocket and file watching.
# Useful inside containers and automated edit sessions.
DISABLE_HMR=false

# By default TCP Browser refuses to proxy loopback, private and cloud-metadata
# addresses, so a deployed instance cannot be used as an SSRF pivot into your
# internal network. Set this to "true" only for local development against
# machines on your own LAN.
TCP_ALLOW_PRIVATE_TARGETS=false
